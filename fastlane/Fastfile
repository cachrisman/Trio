default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"]
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

require "set"

def swift_files_from_patches(workspace_root)
  patches_dir = File.join(workspace_root, "patches")
  return [] unless Dir.exist?(patches_dir)

  Dir.glob(File.join(patches_dir, "**/*.patch"))
     .flat_map { |patch| extract_swift_paths_from_patch(patch) }
     .uniq
     .select { |relative_path| File.exist?(File.join(workspace_root, relative_path)) }
end

def extract_swift_paths_from_patch(path)
  new_files = []
  lines = File.readlines(path, chomp: true)
  
  lines.each_with_index do |line, i|
    # Look for diff headers
    if line.start_with?("diff --git")
      # Check the next line to determine if this is a new file
      next_line = lines[i + 1] if i + 1 < lines.length
      
      # Only process if it's a new file (indicated by "new file mode")
      # If next line starts with "index", it's a modified existing file - skip it
      if next_line && next_line.start_with?("new file mode")
        # This is a new file - find the +++ b/ line (usually 2-3 lines after)
        (i + 2..[i + 5, lines.length - 1].min).each do |j|
          if lines[j] && lines[j].start_with?("+++ b/")
            file_path = lines[j].delete_prefix("+++ b/").strip
            if file_path.end_with?(".swift")
              new_files << file_path
            end
            break
          end
        end
      end
      # Explicitly skip if next line is "index" (modified file) or "--- a/" (modified file)
      # No action needed - we just don't add it to new_files
    end
  end
  
  new_files
end

def find_crashlytics_upload_symbols
  env_path = ENV["CRASHLYTICS_UPLOAD_SYMBOLS"]
  if env_path && File.file?(env_path)
    UI.message("Using CRASHLYTICS_UPLOAD_SYMBOLS env var: #{env_path}")
    return env_path
  end

  workspace_root = GITHUB_WORKSPACE || Dir.pwd
  candidates = []
  
  # SPM: Check DerivedData for upload-symbols (built during Xcode build)
  candidates.concat(Dir.glob(File.expand_path("~/Library/Developer/Xcode/DerivedData/**/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")))
  
  # SPM: Check workspace-level SourcePackages
  candidates.concat(Dir.glob(File.join(workspace_root, "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")))
  
  # SPM: Also check for the 'run' script which can be used as alternative
  candidates.concat(Dir.glob(File.expand_path("~/Library/Developer/Xcode/DerivedData/**/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/run")))
  
  # CocoaPods path
  candidates.concat(Dir.glob(File.join(workspace_root, "Pods/FirebaseCrashlytics/upload-symbols")))
  
  # Legacy Fabric path
  candidates.concat(Dir.glob("/Applications/Fabric.app/**/upload-symbols"))

  # Filter to only existing files
  existing = candidates.select { |path| File.file?(path) }
  
  if existing.empty?
    UI.message("Crashlytics upload tool search paths checked:")
    UI.message("  - ~/Library/Developer/Xcode/DerivedData/**/firebase-ios-sdk/Crashlytics/upload-symbols")
    UI.message("  - #{workspace_root}/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")
    UI.message("  - ~/Library/Developer/Xcode/DerivedData/**/firebase-ios-sdk/Crashlytics/run")
    UI.message("  - #{workspace_root}/Pods/FirebaseCrashlytics/upload-symbols")
    return nil
  end
  
  # Prefer upload-symbols over run script
  upload_symbols = existing.find { |p| p.end_with?("upload-symbols") }
  result = upload_symbols || existing.first
  UI.message("Found Crashlytics upload tool: #{result}")
  result
end

def get_app_store_connect_api_key
  app_store_connect_api_key(
    key_id: FASTLANE_KEY_ID,
    issuer_id: FASTLANE_ISSUER_ID,
    key_content: FASTLANE_KEY
  )
end

# Define method to parse xcconfig file, and replace $(DEVELOPMENT_TEAM) with ENV["TEAMID"]
def parse_xcconfig_file(path)
  xcconfig = {}
  File.open(path).each_line do |line|
    line.strip!
    next if line.empty? || line.start_with?('//')
    parts = line.split('=')
    next if parts.length < 2  # Skip lines without '='
    key, value = parts.map(&:strip)
    # Replace $(DEVELOPMENT_TEAM) with ENV["TEAMID"]
    value = value.gsub('$(DEVELOPMENT_TEAM)', TEAMID)
    xcconfig[key] = value
      end
      xcconfig
    end

# Path to config.xcconfig file
xcconfig_path = "#{GITHUB_WORKSPACE}/Config.xcconfig"

# Load the variables from config.xcconfig
xcconfig = parse_xcconfig_file(xcconfig_path)

# Access BUNDLE_IDENTIFIER from the xcconfig file after replacing $(DEVELOPMENT_TEAM) with ENV["TEAMID"]
ENV["BUNDLE_ID"] = xcconfig["BUNDLE_IDENTIFIER"]

# limit lane names to letters and underscores
platform :ios do
  desc "Build Trio"
  lane :build_trio do
    setup_ci if ENV['CI']
    BUNDLE_ID = ENV["BUNDLE_ID"]
    workspace_root = GITHUB_WORKSPACE || Dir.pwd

    new_swift_files = swift_files_from_patches(workspace_root)
    if new_swift_files.empty?
      UI.message("No new Swift files found in patches; skipping project file sync.")
    else
      UI.message("Ensuring new Swift files are added to the project...")
      sync_script = File.join(workspace_root, "scripts", "sync_project_files.rb")
      if File.exist?(sync_script)
        sh("ruby", sync_script, *new_swift_files)
      else
        UI.user_error!("Missing #{sync_script} - include scripts/sync_project_files.rb in the patch.")
      end
    end

    update_project_team(
      path: "#{GITHUB_WORKSPACE}/Trio.xcodeproj",
      teamid: "#{TEAMID}"
    )

    api_key = get_app_store_connect_api_key

    previous_build_number = latest_testflight_build_number(
      app_identifier: "#{BUNDLE_ID}",
      api_key: api_key,
    )

    current_build_number = previous_build_number + 1

    increment_build_number(
      xcodeproj: "#{GITHUB_WORKSPACE}/Trio.xcodeproj",
      build_number: current_build_number
    )      
    
    match(
      type: "appstore",
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [
        "#{BUNDLE_ID}",
        "#{BUNDLE_ID}.watchkitapp",
        "#{BUNDLE_ID}.watchkitapp.TrioWatchComplication",
        "#{BUNDLE_ID}.LiveActivity"

      ]
    )

    mapping = Actions.lane_context[
      SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING
    ]

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Trio.xcodeproj",
      profile_name: mapping["#{BUNDLE_ID}"],
      code_sign_identity: "iPhone Distribution",
      targets: ["Trio"]
    )

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Trio.xcodeproj",
      profile_name: mapping["#{BUNDLE_ID}.watchkitapp"],
      code_sign_identity: "iPhone Distribution",
      targets: ["Trio Watch App"]
    )

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Trio.xcodeproj",
      profile_name: mapping["#{BUNDLE_ID}.watchkitapp.TrioWatchComplication"],
      code_sign_identity: "iPhone Distribution",
      targets: ["Trio Watch Complication Extension"]
    )

    update_code_signing_settings(
      path: "#{GITHUB_WORKSPACE}/Trio.xcodeproj",
      profile_name: mapping["#{BUNDLE_ID}.LiveActivity"],
      code_sign_identity: "iPhone Distribution",
      targets: ["LiveActivityExtension"]
    )

    gym(
      export_method: "app-store",
      scheme: "Trio",
      output_name: "Trio.ipa",
      configuration: "Release",
      destination: 'generic/platform=iOS',
      buildlog_path: 'build/buildlog',
      clean: true,
      export_options: {
        uploadSymbols: false
      }
    )

    copy_artifacts(
      target_path: "artifacts",
      artifacts: ["*.mobileprovision", "*.ipa", "*.dSYM.zip"]
    )

    # Upload dSYMs to Firebase Crashlytics
    upload_dsyms_to_crashlytics
  end

  desc "Upload dSYMs to Firebase Crashlytics"
  lane :upload_dsyms_to_crashlytics do
    workspace_root = GITHUB_WORKSPACE || Dir.pwd

    # Try multiple possible locations for the dSYM zip
    dsym_candidates = [
      File.join(workspace_root, "artifacts", "Trio.app.dSYM.zip"),
      File.join(workspace_root, "Trio.app.dSYM.zip")
    ]
    dsym_zip = dsym_candidates.find { |p| File.exist?(p) }

    gsp_path = File.join(workspace_root, "Trio", "GoogleService-Info.plist")

    unless dsym_zip
      UI.important("dSYM zip not found at any of these locations:")
      dsym_candidates.each { |p| UI.important("  - #{p}") }
      UI.important("Skipping Crashlytics upload")
      next
    end

    unless File.exist?(gsp_path)
      UI.important("GoogleService-Info.plist not found at #{gsp_path}, skipping Crashlytics upload")
      next
    end

    # Extract Firebase App ID from GoogleService-Info.plist
    app_id = nil
    begin
      require 'plist'
      plist_data = Plist.parse_xml(gsp_path)
      app_id = plist_data["GOOGLE_APP_ID"] if plist_data
    rescue LoadError
      # Plist gem not available, try shell parsing
      app_id = `plutil -extract GOOGLE_APP_ID raw -o - "#{gsp_path}" 2>/dev/null`.strip
      app_id = nil if app_id.empty?
    rescue => e
      UI.message("Could not parse GoogleService-Info.plist: #{e.message}")
    end

    UI.message("Uploading dSYMs to Firebase Crashlytics...")
    UI.message("  dSYM: #{dsym_zip}")
    UI.message("  GoogleService-Info.plist: #{gsp_path}")
    UI.message("  Firebase App ID: #{app_id || 'not found'}")

    uploaded = false

    # Method 1: Try Firebase CLI first (installed via npm in CI)
    firebase_cli = `which firebase 2>/dev/null`.strip
    if !firebase_cli.empty? && app_id
      UI.message("Using Firebase CLI for dSYM upload...")
      begin
        sh("firebase", "crashlytics:symbols:upload", "--app=#{app_id}", dsym_zip)
        UI.success("Successfully uploaded dSYMs via Firebase CLI")
        uploaded = true
      rescue => e
        UI.message("Firebase CLI upload failed: #{e.message}, trying fallback...")
      end
    end

    # Method 2: Fall back to upload-symbols tool
    unless uploaded
      upload_tool = find_crashlytics_upload_symbols
      if upload_tool
        UI.message("Using upload-symbols tool: #{upload_tool}")
        begin
          sh(upload_tool, "-gsp", gsp_path, "-p", "ios", dsym_zip)
          UI.success("Successfully uploaded dSYMs via upload-symbols")
          uploaded = true
        rescue => e
          UI.error("upload-symbols failed: #{e.message}")
        end
      end
    end

    unless uploaded
      UI.important("Could not upload dSYMs automatically.")
      UI.important("You can manually upload using:")
      UI.important("  firebase crashlytics:symbols:upload --app=#{app_id || '<APP_ID>'} #{dsym_zip}")
      UI.important("Or use the upload-symbols tool locally.")
    end
  end

  desc "Push to TestFlight"
  lane :release do
    api_key = get_app_store_connect_api_key
    
    upload_to_testflight(
      api_key: api_key,
      skip_submission: false,
      ipa: "Trio.ipa",
      skip_waiting_for_build_processing: true,
      changelog: git_branch+" "+last_git_commit[:abbreviated_commit_hash],
    )
  end

  desc "Provision Identifiers and Certificates"
  lane :identifiers do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    BUNDLE_ID = ENV["BUNDLE_ID"]
    
    get_app_store_connect_api_key

    def configure_bundle_id(name, identifier, capabilities)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier) || Spaceship::ConnectAPI::BundleId.create(
        name:       name,
        identifier: identifier,
        platform:   "IOS"
      )
      existing = bundle_id.get_capabilities.map(&:capability_type)
      capabilities.reject { |c| existing.include?(c) }.each do |cap|
        bundle_id.create_capability(cap)
      end
    end

    configure_bundle_id("Trio", "#{BUNDLE_ID}", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
      Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT,
      Spaceship::ConnectAPI::BundleIdCapability::Type::NFC_TAG_READING,
      Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    ])

    configure_bundle_id("Trio Watch Complication", "#{BUNDLE_ID}.watchkitapp.TrioWatchComplication", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS
    ])
    
    configure_bundle_id("Trio Watch App", "#{BUNDLE_ID}.watchkitapp", [
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
      Spaceship::ConnectAPI::BundleIdCapability::Type::HEALTHKIT
    ])

    configure_bundle_id("Trio LiveActivity", "#{BUNDLE_ID}.LiveActivity", [])
    
  end

  desc "Provision Certificates"
  lane :certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    BUNDLE_ID = ENV["BUNDLE_ID"]
    
    get_app_store_connect_api_key
    
    match(
      type: "appstore",
      force: false,
      verbose: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [
        "#{BUNDLE_ID}",
        "#{BUNDLE_ID}.watchkitapp",
        "#{BUNDLE_ID}.watchkitapp.TrioWatchComplication",
        "#{BUNDLE_ID}.LiveActivity"
      ]
    )
  end

  desc "Validate Secrets"
  lane :validate_secrets do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = true.to_s
    BUNDLE_ID = ENV["BUNDLE_ID"]

    get_app_store_connect_api_key

    Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)

    match(
      type: "appstore",
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}"),
      app_identifier: [],
    )
  end

  desc "Nuke Certs"
  lane :nuke_certs do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
    
    get_app_store_connect_api_key
    
    match_nuke(
      type: "appstore",
      team_id: "#{TEAMID}",
      skip_confirmation: true,
      git_basic_authorization: Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
    )
  end

  desc "Check Certificates and Trigger Workflow for Expired or Missing Certificates"
  lane :check_and_renew_certificates do
    setup_ci if ENV['CI']
    ENV["MATCH_READONLY"] = false.to_s
  
    get_app_store_connect_api_key
  
    # Initialize flag to track if renewal of certificates is needed
    new_certificate_needed = false
  
    # Fetch all certificates
    certificates = Spaceship::ConnectAPI::Certificate.all
  
    # Filter for Distribution Certificates
    distribution_certs = certificates.select { |cert| cert.certificate_type == "DISTRIBUTION" }
  
    # Handle case where no distribution certificates are found
    if distribution_certs.empty?
      puts "No Distribution certificates found! Triggering action to create certificate."
      new_certificate_needed = true
    else
      # Check for expiration
      distribution_certs.each do |cert|
        expiration_date = Time.parse(cert.expiration_date)
  
        puts "Current Distribution Certificate: #{cert.id}, Expiration date: #{expiration_date}"
  
        if expiration_date < Time.now
          puts "Distribution Certificate #{cert.id} is expired! Triggering action to renew certificate."
          new_certificate_needed = true
        else
          puts "Distribution certificate #{cert.id} is valid. No action required."
        end
      end
    end
  
    # Write result to new_certificate_needed.txt
    file_path = File.expand_path('new_certificate_needed.txt')
    File.write(file_path, new_certificate_needed ? 'true' : 'false')  
  
    # Log the absolute path and contents of the new_certificate_needed.txt file
    puts ""
    puts "Absolute path of new_certificate_needed.txt: #{file_path}"
    new_certificate_needed_content = File.read(file_path)
    puts "Certificate creation or renewal needed: #{new_certificate_needed_content}"
  end
end
