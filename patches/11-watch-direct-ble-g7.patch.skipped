+            Task {
+                await WatchLogger.shared.log(
+                    "event=g7_ble_lifecycle phase=inactive reason=scenePhase_change ble_continues=true g7_session=\(sid) active_window_s=\(g7ActiveWindowS) active_window_ms=\(g7ActiveWindowMs)"
