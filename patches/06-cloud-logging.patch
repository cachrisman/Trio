+import Foundation
+
+struct BetterStackSettings: Decodable {
+    let BetterStackSourceToken: String?
+    let BetterStackIngestionUrl: String?
+}
+
+enum BetterStackSettingsStore {
+    static let relativePath = "settings/BetterStack.json"
+
+    /// Loads Better Stack settings from the app group container (preferred) and falls back to app documents.
+    static func load() -> BetterStackSettings? {
+        // Prefer the configured AppGroupID (Info.plist key "AppGroupID") if present.
+        if let suite = Bundle.main.appGroupSuiteName, !suite.isEmpty {
+            if let settings = load(from: .sharedContainer(appGroupName: suite)) {
+                return settings
+            }
+        }
+
+        // Fallback: some builds use a short app group name like "Trio".
+        if let settings = load(from: .sharedContainer(appGroupName: "Trio")) {
+            return settings
+        }
+
+        // Fallback to local documents directory (useful for simulator/dev environments).
+        return load(from: .documents)
+    }
+
+    private static func load(from directory: Disk.Directory) -> BetterStackSettings? {
+        guard let data = try? Disk.retrieve(relativePath, from: directory, as: Data.self) else {
+            return nil
+        }
+        return try? JSONDecoder().decode(BetterStackSettings.self, from: data)
+    }
+}
diff --git a/Trio/Sources/Logger/CloudLogging/CloudDeterminationLogger.swift b/Trio/Sources/Logger/CloudLogging/CloudDeterminationLogger.swift
new file mode 100644
index 000000000..322e54eb9
--- /dev/null
+++ b/Trio/Sources/Logger/CloudLogging/CloudDeterminationLogger.swift
@@ -0,0 +1,67 @@
+import Combine
+import CoreData
+import Foundation
+
+// Forwards each new OrefDetermination to the cloud sink (only; the in-app export already reads them from
+// CoreData). Subscribes the same way IOBService does.
+final class CloudDeterminationLogger: @unchecked Sendable {
+    static let shared = CloudDeterminationLogger()
+
+    private let queue = DispatchQueue(label: "CloudDeterminationLogger.queue", qos: .utility)
+    private var subscription: AnyCancellable?
+    // Confined to `queue`
+    private var dedupe = DeterminationDedupe<NSManagedObjectID>(capacity: 100)
+    private var started = false
+
+    func start() {
+        // Synchronous: entityChangePublisher doesn't replay, so subscribe before start() returns
+        queue.sync {
+            guard !self.started else { return }
+            self.started = true
+            self.subscription = CoreDataStack.shared.entityChangePublisher
+                .receive(on: self.queue)
+                .filteredByEntityName("OrefDetermination")
+                .sink { [weak self] ids in self?.handle(ids) }
+        }
+    }
+
+    private func handle(_ ids: Set<NSManagedObjectID>) {
+        let context = CoreDataStack.shared.newTaskContext()
+        context.name = "cloudDeterminationLogger"
+        let lines: [(NSManagedObjectID, Bool, Date?, String)] = context.performAndWait {
+            ids.compactMap { id in
+                guard let determination = try? context.existingObject(with: id) as? OrefDetermination else { return nil }
+                return (
+                    id,
+                    determination.enacted,
+                    determination.deliverAt ?? determination.timestamp,
+                    LogExport.algorithmText(determination)
+                )
+            }
+        }
+        for (id, enacted, date, text) in lines {
+            switch dedupe.observe(id: id, enacted: enacted, date: date) {
+            case .new:
+                emit("Determination \(text)", at: date ?? Date())
+            case .enactedFlip:
+                let deliverAt = date.map { ISO8601DateFormatter().string(from: $0) } ?? "unknown"
+                emit("Determination enacted (deliverAt \(deliverAt))", at: Date())
+            case .none:
+                break
+            }
+        }
+    }
+
+    private func emit(_ message: String, at date: Date) {
+        CloudLogSink.shared.accept(LogRecord(
+            timestamp: date,
+            level: .info,
+            category: "Algorithm",
+            message: message,
+            file: #fileID,
+            function: #function,
+            line: #line,
+            launchID: LaunchID.current
+        ))
+    }
+}
diff --git a/Trio/Sources/Logger/CloudLogging/CloudDeviceLogForwarder.swift b/Trio/Sources/Logger/CloudLogging/CloudDeviceLogForwarder.swift
