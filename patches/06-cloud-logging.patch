--- /dev/null
+++ b/Trio/Sources/Logger/CloudLogging/CloudDeviceLogForwarder.swift
@@ -0,0 +1,37 @@
+import Foundation
+
+// Sends the diagnostic subset of device-log entries straight to the cloud sink. It deliberately bypasses
+// TrioLogger: LogExport already merges DeviceLogStore, so tee'ing through AppLogStore would duplicate lines.
+final class CloudDeviceLogForwarder: @unchecked Sendable {
+    static let shared = CloudDeviceLogForwarder()
+
+    private let policy: DeviceLogForwardingPolicy
+    private let sink: LogSink
+
+    init(policy: DeviceLogForwardingPolicy = DeviceLogForwardingPolicy(), sink: LogSink = CloudLogSink.shared) {
+        self.policy = policy
+        self.sink = sink
+    }
+
+    /// Called synchronously from `DeviceLogStore.log`, so the timestamp is the event time.
+    func forward(managerIdentifier: String, typeRawValue: String, message: String) {
+        let timestamp = Date()
+        guard let decision = policy.decide(
+            managerIdentifier: managerIdentifier,
+            typeRawValue: typeRawValue,
+            message: message
+        ) else { return }
+        // Category can't be derived cheaply here (DeviceLogStore doesn't know the active managers), so the
+        // manager identifier rides in the message.
+        sink.accept(LogRecord(
+            timestamp: timestamp,
+            level: decision.isWarning ? .warning : .info,
+            category: "Device",
+            message: decision.text,
+            file: #fileID,
+            function: #function,
+            line: #line,
+            launchID: LaunchID.current
+        ))
+    }
+}
diff --git a/Trio/Sources/Logger/CloudLogging/CloudLogForwardingLogic.swift b/Trio/Sources/Logger/CloudLogging/CloudLogForwardingLogic.swift
new file mode 100644
index 000000000..3d607b511
--- /dev/null
+++ b/Trio/Sources/Logger/CloudLogging/CloudLogForwardingLogic.swift
@@ -0,0 +1,249 @@
+import Foundation
+
+// Pure, Foundation-only decisions for forwarding device logs and determinations to the cloud.
+// Kept free of LoopKit, CoreData and UIKit so it can be unit tested in isolation.
+
+enum DeviceLogForwardingFilter {
+    static let maxMessageLength = 1000
+    static let latencyMarker = "connect latency"
+    static let connectedMarker = "CONNECTED"
+
+    /// `typeRawValue` is the LoopKit `DeviceLogEntryType.rawValue`.
+    static func shouldForward(typeRawValue: String, message: String) -> Bool {
+        if typeRawValue == "error" || typeRawValue == "connection" { return true }
+        return message.contains(latencyMarker) || message.contains(connectedMarker)
+    }
+
+    static func isWarning(typeRawValue: String) -> Bool {
+        typeRawValue == "error"
+    }
+
+    static func format(managerIdentifier: String, typeRawValue: String, message: String, reserving reserved: Int = 0) -> String {
+        let text = "\(managerIdentifier) [\(typeRawValue)] \(message)"
+        let limit = max(0, maxMessageLength - reserved)
+        return text.count > limit ? String(text.prefix(limit)) : text
+    }
+}
+
+/// Lock-protected; `DeviceLogStore.log` is called from arbitrary threads.
+final class DeviceLogForwardingPolicy: @unchecked Sendable {
+    struct Decision: Equatable {
+        let isWarning: Bool
+        let text: String
+    }
+
+    static let backfillMarker = "Backfill frame of unexpected length"
+    static let backfillInterval: TimeInterval = 5 * 60
+
+    private let clock: () -> Date
+    private let lock = NSLock()
+    private var lastBackfillForward: Date?
+    private var suppressedBackfill = 0
+
+    init(clock: @escaping () -> Date = { Date() }) {
+        self.clock = clock
+    }
+
+    func decide(managerIdentifier: String, typeRawValue: String, message: String) -> Decision? {
+        guard DeviceLogForwardingFilter.shouldForward(typeRawValue: typeRawValue, message: message) else { return nil }
+        var suffix = ""
+        if message.contains(Self.backfillMarker) {
+            let now = clock()
+            lock.lock()
+            if let last = lastBackfillForward, now >= last, now.timeIntervalSince(last) < Self.backfillInterval {
+                suppressedBackfill += 1
+                lock.unlock()
+                return nil
+            }
+            if suppressedBackfill > 0 { suffix = " (+\(suppressedBackfill) suppressed)" }
+            suppressedBackfill = 0
+            lastBackfillForward = now
+            lock.unlock()
+        }
+        let text = DeviceLogForwardingFilter.format(
+            managerIdentifier: managerIdentifier,
+            typeRawValue: typeRawValue,
+            message: message,
+            reserving: suffix.count
+        ) + suffix
+        return Decision(isWarning: DeviceLogForwardingFilter.isWarning(typeRawValue: typeRawValue), text: text)
+    }
+}
+
+/// Remembers recently seen determinations; reports new ones and a later flip to enacted once.
+struct DeterminationDedupe<ID: Hashable> {
+    enum Outcome: Equatable {
+        case new
+        case enactedFlip
+        case none
+    }
+
+    let capacity: Int
+    private var seen: [ID: Bool] = [:]
+    private var order: [ID] = []
+
+    init(capacity: Int = 100) {
+        self.capacity = max(1, capacity)
+    }
+
+    var count: Int { seen.count }
+
+    /// Old determinations arrive as updates (Nightscout upload flags, relaunch, history replay)
+    /// and must not be re-logged, so only determinations this close to now are reported.
+    static var recencyWindow: TimeInterval { 15 * 60 }
+
+    mutating func observe(id: ID, enacted: Bool, date: Date?, now: Date = Date()) -> Outcome {
+        let recent = date.map { abs(now.timeIntervalSince($0)) <= Self.recencyWindow } ?? false
+        if let wasEnacted = seen[id] {
+            guard enacted, !wasEnacted else { return .none }
+            seen[id] = true
+            return recent ? .enactedFlip : .none
+        }
+        guard recent else { return .none }
+        seen[id] = enacted
+        order.append(id)
+        if order.count > capacity {
+            seen.removeValue(forKey: order.removeFirst())
+        }
+        return .new
+    }
+}
+
+enum CloudLogUploadFailureAction: Equatable {
+    case rejectRows
+    case retryLater
+}
+
+enum CloudLogUploadFailurePolicy {
+    private static let retryLaterClientCodes: Set<Int> = [401, 403, 404, 408, 429]
+
+    static func action(for error: CloudLogUploadError) -> CloudLogUploadFailureAction {
+        switch error {
+        case .encoding:
+            return .rejectRows
+        case let .unexpectedStatus(code, _):
+            guard (400 ..< 500).contains(code), !retryLaterClientCodes.contains(code) else { return .retryLater }
+            return .rejectRows
+        case .notConfigured, .invalidURL, .transport, .invalidResponse:
+            return .retryLater
+        }
+    }
+}
+
+// MARK: - Cloud log batch upload drain (testable; mirrors `CloudLogUploadService.runPass` per-batch loop)
+
+enum CloudLogBatchUploadDrain {
+    enum Outcome: Equatable {
+        case batchComplete
+        case stopPass
+    }
+
+    struct Handlers: Sendable {
+        let encodedSize: @Sendable ([CloudLogEvent]) -> Int?
+        let upload: @Sendable ([CloudLogEvent]) async -> Result<Void, CloudLogUploadError>
+        let commit: @Sendable (CloudLogQueue.Cursor, UInt64) async -> Void
+        let addDropped: @Sendable (UInt64) -> Void
+        let logRejectedRow: @Sendable (String) -> Void
+        let uploadDropVisibility: @Sendable (CloudLogEvent) async -> Void
+    }
+
+    struct Context: Sendable {
+        let itemEvents: [CloudLogEvent]
+        let itemEnds: [CloudLogQueue.Cursor]
+        let itemSkips: [Int]
+        var persistedDropped: UInt64
+        let rangeStart: CloudLogQueue.Cursor
+        let common: CloudLogCommonAttributes
+        let maxRequestBytes: Int
+        let maxRequestsPerPass: Int
+    }
+
+    static func rejectionStatusLabel(for error: CloudLogUploadError) -> String {
+        switch error {
+        case .encoding:
+            return "encoding"
+        case let .unexpectedStatus(code, _):
+            return String(code)
+        case .notConfigured, .invalidURL, .transport, .invalidResponse:
+            return "retry"
+        }
+    }
+
+    static func drain(
+        handlers: Handlers,
+        context: Context,
+        requests: inout Int
+    ) async -> Outcome {
+        let count = context.itemEvents.count
+        guard count > 0 else { return .batchComplete }
+
+        let ctx = context
+        var persistedPending = ctx.persistedDropped
+        var lo = 0
+        var hi = count
+
+        while lo < count {
+            func droppedCount(_ upper: Int) -> UInt64 {
+                persistedPending &+ UInt64(ctx.itemSkips[lo ..< upper].reduce(0, +))
+            }
+            func events(upTo upper: Int) -> [CloudLogEvent] {
+                let dropped = droppedCount(upper)
+                let dropEvents = dropped > 0 ? [CloudLogEvent.dropped(count: dropped, common: ctx.common)] : []
+                return dropEvents + ctx.itemEvents[lo ..< upper]
+            }
+
+            while hi - lo > 1,
+                  let size = handlers.encodedSize(events(upTo: hi)),
+                  size > ctx.maxRequestBytes
+            {
+                hi = lo + max(1, (hi - lo) / 2)
+            }
+
+            guard requests < ctx.maxRequestsPerPass else { return .stopPass }
+            requests += 1
+
+            switch await handlers.upload(events(upTo: hi)) {
+            case .success:
+                await handlers.commit(ctx.itemEnds[hi - 1], persistedPending)
+                persistedPending = 0
+                lo = hi
+                hi = count
+            case let .failure(error):
+                switch CloudLogUploadFailurePolicy.action(for: error) {
+                case .retryLater:
+                    return .stopPass
+                case .rejectRows:
+                    if hi - lo > 1 {
+                        hi = lo + (hi - lo) / 2
+                        continue
+                    }
+                    let status = rejectionStatusLabel(for: error)
+                    handlers.logRejectedRow(status)
+                    let lostSkips = UInt64(ctx.itemSkips[lo])
+                    let rowEnd = ctx.itemEnds[lo]
+                    let rowStart = lo == 0 ? ctx.rangeStart : ctx.itemEnds[lo - 1]
+                    await handlers.commit(rowEnd, 0)
+                    let droppedRows = 1 &+ lostSkips
+                    handlers.addDropped(droppedRows)
+
+                    if requests < ctx.maxRequestsPerPass {
+                        requests += 1
+                        let visibility = CloudLogEvent.rowDropped(
+                            status: status,
+                            rows: droppedRows,
+                            rangeStart: rowStart,
+                            rangeEnd: rowEnd,
+                            common: ctx.common
+                        )
+                        await handlers.uploadDropVisibility(visibility)
+                    }
+
+                    lo += 1
+                    hi = count
+                }
+            }
+        }
+
+        return .batchComplete
+    }
+}
diff --git a/Trio/Sources/Logger/CloudLogging/CloudLogProvider.swift b/Trio/Sources/Logger/CloudLogging/CloudLogProvider.swift
new file mode 100644
index 000000000..5b9e38d19
--- /dev/null
+++ b/Trio/Sources/Logger/CloudLogging/CloudLogProvider.swift
@@ -0,0 +1,287 @@
+import Foundation
+
+extension CloudLogQueue.Cursor: CustomStringConvertible {
+    var description: String { "\(segment):\(offset)" }
+}
+
+protocol CloudLogProvider {
+    /// Uploads a batch of events.
+    ///
+    /// - Important: Must only treat HTTP 202 as success.
+    func upload(events: [CloudLogEvent]) async -> Result<Void, CloudLogUploadError>
+}
+
+enum CloudLogUploadError: Error, CustomStringConvertible {
+    case notConfigured
+    case invalidURL
+    case transport(Error)
+    case invalidResponse
+    case unexpectedStatus(code: Int, bodyPreview: String?)
+    case encoding(Error)
+
+    var description: String {
+        switch self {
+        case .notConfigured:
+            return "Cloud logging not configured"
+        case .invalidURL:
+            return "Invalid cloud logging URL"
+        case let .transport(error):
+            return "Transport error: \(error)"
+        case .invalidResponse:
+            return "Invalid HTTP response"
+        case let .unexpectedStatus(code, bodyPreview):
+            return "Unexpected HTTP status: \(code) body: \(bodyPreview ?? "<nil>")"
+        case let .encoding(error):
+            return "Encoding error: \(error)"
+        }
+    }
+}
+
+struct CloudLogCommonAttributes {
+    let build: String
+    let appVersion: String
+    let env: String
+
+    static let current: CloudLogCommonAttributes = {
+        let info = Bundle.main.infoDictionary
+        let env: String
+        if BuildDetails.shared.isTestFlightBuild() {
+            env = "testflight"
+        } else {
+            #if DEBUG
+                env = "debug"
+            #else
+                env = "release"
+            #endif
+        }
+        return CloudLogCommonAttributes(
+            build: info?["CFBundleVersion"] as? String ?? "unknown",
+            appVersion: info?["CFBundleShortVersionString"] as? String ?? "unknown",
+            env: env
+        )
+    }()
+}
+
+struct CloudLogEvent: Encodable {
+    let message: String
+    let dt: String?
+    let attributes: [String: String]?
+
+    // Custom encoding to flatten attributes to top-level fields
+    enum CodingKeys: String, CodingKey {
+        case message
+        case dt
+        case platform
+        case build
+        case category
+        case appVersion
+        case env
+        case level
+        case severity
+        case file
+        case method
+        case lineNumber
+        case source
+        case event
+        case windowId = "window_id"
+        case taskType = "task_type"
+    }
+
+    private static let maxMessageBytes = 64 * 1024
+    private static let truncationSuffix = "…[truncated]"
+
+    private static let eventRegex = try? NSRegularExpression(pattern: #"\bevent=([^ ]+)"#)
+    private static let windowIdRegex = try? NSRegularExpression(pattern: #"\bwindow_id=(-?[0-9]+)"#)
+    private static let taskTypeRegex = try? NSRegularExpression(pattern: #"\btask_type=([^ ]+)"#)
+    private static let complicationRegex = try? NSRegularExpression(pattern: #"\bsrc=complication\b"#)
+
+    func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(message, forKey: .message)
+        if let dt = dt {
+            try container.encode(dt, forKey: .dt)
+        }
+
+        // Flatten attributes to top-level fields
+        if let attrs = attributes {
+            if let platform = attrs["platform"] {
+                try container.encode(platform, forKey: .platform)
+            }
+            if let build = attrs["build"] {
+                try container.encode(build, forKey: .build)
+            }
+            if let category = attrs["category"] {
+                try container.encode(category, forKey: .category)
+            }
+            if let appVersion = attrs["appVersion"] {
+                try container.encode(appVersion, forKey: .appVersion)
+            }
+            if let env = attrs["env"] {
+                try container.encode(env, forKey: .env)
+            }
+            if let level = attrs["level"] {
+                try container.encode(level, forKey: .level)
+            }
+            if let severity = attrs["severity"] {
+                try container.encode(severity, forKey: .severity)
+            }
+            if let file = attrs["file"] {
+                try container.encode(file, forKey: .file)
+            }
+            if let method = attrs["method"] {
+                try container.encode(method, forKey: .method)
+            }
+            if let lineNumber = attrs["lineNumber"] {
+                try container.encode(lineNumber, forKey: .lineNumber)
+            }
+            if let source = attrs["source"] {
+                try container.encode(source, forKey: .source)
+            }
+        }
+
+        if let value = Self.extractToken(from: message, regex: Self.eventRegex) {
+            try container.encode(value, forKey: .event)
+        }
+        if let value = Self.extractToken(from: message, regex: Self.windowIdRegex),
+           let intValue = Int(value)
+        {
+            try container.encode(intValue, forKey: .windowId)
+        }
+        if let value = Self.extractToken(from: message, regex: Self.taskTypeRegex) {
+            try container.encode(value, forKey: .taskType)
+        }
+    }
+
+    static func make(from record: LogRecord, common: CloudLogCommonAttributes) -> CloudLogEvent {
+        let isWatch = record.category.hasPrefix("Watch/")
+
+        let legacyLevel: String
+        let severity: String
+        switch record.level {
+        case .debug:
+            legacyLevel = "debug"
+            severity = "debug"
+        case .info:
+            legacyLevel = "info"
+            severity = "info"
+        case .notice:
+            legacyLevel = "info"
+            severity = "notice"
+        case .warning:
+            legacyLevel = "warn"
+            severity = "warning"
+        case .error:
+            legacyLevel = "error"
+            severity = "error"
+        case .fault:
+            legacyLevel = "error"
+            severity = "fault"
+        }
+
+        let source: String
+        if matches(complicationRegex, in: record.message) {
+            source = "complication"
+        } else if isWatch {
+            source = "watch"
+        } else {
+            source = "phone"
+        }
+
+        var attributes: [String: String] = [
+            "platform": isWatch ? "watchos" : "ios",
+            "build": common.build,
+            "category": record.category,
+            "appVersion": common.appVersion,
+            "env": common.env,
+            "level": legacyLevel,
+            "severity": severity,
+            "source": source
+        ]
+        if !record.file.isEmpty, record.file != "Watch", !record.function.isEmpty, record.line > 0 {
+            attributes["file"] = record.file
+            attributes["method"] = record.function
+            attributes["lineNumber"] = String(record.line)
+        }
+
+        return CloudLogEvent(
+            message: truncated(record.message),
+            dt: isoString(from: record.timestamp),
+            attributes: attributes
+        )
+    }
+
+    static func dropped(count: UInt64, common: CloudLogCommonAttributes) -> CloudLogEvent {
+        CloudLogEvent(
+            message: "event=cloud_log_dropped count=\(count) CloudLogQueue dropped rows before upload",
+            dt: isoString(from: Date()),
+            attributes: [
+                "platform": "ios",
+                "build": common.build,
+                "category": "CloudLogging",
+                "appVersion": common.appVersion,
+                "env": common.env,
+                "level": "warn",
+                "severity": "warning",
+                "source": "phone"
+            ]
+        )
+    }
+
+    static func rowDropped(
+        status: String,
+        rows: UInt64,
+        rangeStart: CloudLogQueue.Cursor,
+        rangeEnd: CloudLogQueue.Cursor,
+        common: CloudLogCommonAttributes
+    ) -> CloudLogEvent {
+        CloudLogEvent(
+            message: "event=cloud_log_row_dropped status=\(status) rows=\(rows) range=\(rangeStart)..\(rangeEnd)",
+            dt: isoString(from: Date()),
+            attributes: [
+                "platform": "ios",
+                "build": common.build,
+                "category": "CloudLogging",
+                "appVersion": common.appVersion,
+                "env": common.env,
+                "level": "warn",
+                "severity": "warning",
+                "source": "phone"
+            ]
+        )
+    }
+
+    private static func isoString(from date: Date) -> String {
+        let formatter = ISO8601DateFormatter()
+        formatter.timeZone = TimeZone(secondsFromGMT: 0)
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return formatter.string(from: date)
+    }
+
+    private static func truncated(_ message: String) -> String {
+        guard message.utf8.count > maxMessageBytes else { return message }
+        let budget = maxMessageBytes - truncationSuffix.utf8.count
+        var result = ""
+        var used = 0
+        for character in message {
+            let size = String(character).utf8.count
+            if used + size > budget { break }
+            result.append(character)
+            used += size
+        }
+        return result + truncationSuffix
+    }
+
+    private static func matches(_ regex: NSRegularExpression?, in string: String) -> Bool {
+        guard let regex else { return false }
+        return regex.firstMatch(in: string, range: NSRange(string.startIndex..., in: string)) != nil
+    }
+
+    private static func extractToken(from string: String, regex: NSRegularExpression?) -> String? {
+        guard let regex,
+              let match = regex.firstMatch(in: string, range: NSRange(string.startIndex..., in: string)),
+              match.numberOfRanges > 1,
+              let range = Range(match.range(at: 1), in: string)
+        else { return nil }
+        return String(string[range])
+    }
+}
diff --git a/Trio/Sources/Logger/CloudLogging/CloudLogQueue.swift b/Trio/Sources/Logger/CloudLogging/CloudLogQueue.swift
new file mode 100644
index 000000000..7326d88f5
--- /dev/null
+++ b/Trio/Sources/Logger/CloudLogging/CloudLogQueue.swift
@@ -0,0 +1,458 @@
+import Foundation
+import os
+
+// The upload cursor is a (segment, byte offset) pair rather than a timestamp: watch rows arrive hours late
+// carrying their original timestamps, so a "last uploaded timestamp" would skip them or re-send everything.
+// The queue is strictly FIFO in arrival order, and the cursor marks the next unread line in that order.
+final class CloudLogQueue: @unchecked Sendable {
+    static let shared = CloudLogQueue()
+
+    struct Cursor: Codable, Equatable {
+        var segment: UInt64
+        var offset: UInt64
+    }
+
+    struct Batch {
+        var start: Cursor
+        var items: [(record: LogRecord, end: Cursor)]
+        /// Rows skipped immediately before each item (parallel to `items`); never persisted.
+        var itemSkips: [Int]
+        /// Cursor after everything this batch read; equals the last item's end when there are items.
+        var end: Cursor
+        /// Part of the dropped counter that is persisted in state; `commit` subtracts it.
+        var persistedDropped: UInt64
+        /// Undecodable or over-long rows skipped while reading this batch; reported once, not persisted.
+        var skippedInBatch: UInt64
+
+        var droppedToReport: UInt64 { persistedDropped &+ skippedInBatch }
+    }
+
+    private struct State: Codable {
+        var segment: UInt64
+        var offset: UInt64
+        var dropped: UInt64
+    }
+
+    private struct Segment {
+        let seq: UInt64
+        let url: URL
+    }
+
+    private static let log = os.Logger(
+        subsystem: Bundle.main.bundleIdentifier ?? "org.nightscout.Trio",
+        category: "CloudLogging"
+    )
+
+    private static let newline = UInt8(ascii: "\n")
+    private static let protection = FileProtectionType.completeUntilFirstUserAuthentication
+
+    static var defaultDirectory: URL {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first
+            ?? FileManager.default.temporaryDirectory
+        return base.appendingPathComponent("CloudLogQueue", isDirectory: true)
+    }
+
+    private let directory: URL
+    private let segmentMaxBytes: Int
+    private let maxTotalBytes: Int
+    private let maxAge: TimeInterval
+    private let fileManager: FileManager
+    private let queue = DispatchQueue(label: "org.nightscout.Trio.CloudLogQueue", qos: .utility)
+    private let encoder: JSONEncoder
+    private let decoder: JSONDecoder
+
+    // Everything below is confined to `queue`.
+    private var cursor = Cursor(segment: 1, offset: 0)
+    private var dropped: UInt64 = 0
+    private var activeSeq: UInt64 = 1
+    private var activeSize: UInt64 = 0
+
+    init(
+        directory: URL = CloudLogQueue.defaultDirectory,
+        segmentMaxBytes: Int = 1_000_000,
+        maxTotalBytes: Int = 32_000_000,
+        maxAge: TimeInterval = 7 * 24 * 60 * 60,
+        fileManager: FileManager = .default
+    ) {
+        self.directory = directory
+        self.segmentMaxBytes = segmentMaxBytes
+        self.maxTotalBytes = maxTotalBytes
+        self.maxAge = maxAge
+        self.fileManager = fileManager
+
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .secondsSince1970
+        self.encoder = encoder
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .secondsSince1970
+        self.decoder = decoder
+
+        queue.sync { self.setUp() }
+    }
+
+    func append(_ records: [LogRecord]) {
+        guard !records.isEmpty else { return }
+        queue.async { self.write(records) }
+    }
+
+    func appendSync(_ records: [LogRecord]) {
+        guard !records.isEmpty else { return }
+        queue.sync { self.write(records) }
+    }
+
+    func addDropped(_ n: UInt64) {
+        guard n > 0 else { return }
+        queue.async {
+            self.dropped &+= n
+            self.saveState()
+        }
+    }
+
+    func nextBatch(maxBytes: Int, maxRecords: Int) async -> Batch? {
+        await withCheckedContinuation { continuation in
+            queue.async {
+                continuation.resume(returning: self.readBatch(maxBytes: maxBytes, maxRecords: maxRecords))
+            }
+        }
+    }
+
+    func commit(through end: Cursor, droppedReported: UInt64) async {
+        await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+            queue.async {
+                if Self.precedes(self.cursor, end) {
+                    self.cursor = end
+                }
+                self.dropped = self.dropped >= droppedReported ? self.dropped - droppedReported : 0
+                for segment in self.listSegments() where segment.seq < self.cursor.segment && segment.seq != self.activeSeq {
+                    self.removeFile(segment.url)
+                }
+                self.saveState()
+                continuation.resume()
+            }
+        }
+    }
+
+    // MARK: - Setup
+
+    private func setUp() {
+        do {
+            try fileManager.createDirectory(
+                at: directory,
+                withIntermediateDirectories: true,
+                attributes: [.protectionKey: Self.protection]
+            )
+            try fileManager.setAttributes([.protectionKey: Self.protection], ofItemAtPath: directory.path)
+            var url = directory
+            var values = URLResourceValues()
+            values.isExcludedFromBackup = true
+            try url.setResourceValues(values)
+        } catch {
+            Self.log.error("Queue directory setup failed: \(error.localizedDescription, privacy: .public)")
+        }
+
+        var segments = listSegments()
+        if segments.isEmpty {
+            createSegment(seq: 1)
+            segments = listSegments()
+        }
+        guard let oldest = segments.first, let active = segments.last else { return }
+        activeSeq = active.seq
+
+        var loaded: State?
+        if let data = try? Data(contentsOf: stateURL) {
+            loaded = try? JSONDecoder().decode(State.self, from: data)
+        }
+        if let loaded {
+            cursor = Cursor(segment: loaded.segment, offset: loaded.offset)
+            dropped = loaded.dropped
+        } else {
+            cursor = Cursor(segment: oldest.seq, offset: 0)
+            dropped = 0
+        }
+
+        if let current = segments.first(where: { $0.seq == cursor.segment }) {
+            let size = fileSize(current.url)
+            if cursor.offset > size { cursor.offset = size }
+        } else {
+            cursor = Cursor(segment: oldest.seq, offset: 0)
+        }
+
+        activeSize = fileSize(active.url)
+        if activeSize > 0, lastByte(of: active.url, size: activeSize) != Self.newline {
+            writeToActive(Data([Self.newline]))
+        }
+
+        enforceCaps()
+        saveState()
+    }
+
+    // MARK: - Writing
+
+    private func write(_ records: [LogRecord]) {
+        var buffer = Data()
+        for record in records {
+            guard var line = try? encoder.encode(record) else {
+                dropped &+= 1
+                continue
+            }
+            line.append(Self.newline)
+            if activeSize > 0, activeSize + UInt64(buffer.count) + UInt64(line.count) > UInt64(segmentMaxBytes) {
+                writeToActive(buffer)
+                buffer.removeAll(keepingCapacity: true)
+                rotate()
+            }
+            buffer.append(line)
+        }
+        writeToActive(buffer)
+        if activeSize >= UInt64(segmentMaxBytes) {
+            rotate()
+        }
+        enforceCaps()
+    }
+
+    private func writeToActive(_ data: Data) {
+        guard !data.isEmpty else { return }
+        let url = segmentURL(activeSeq)
+        if !fileManager.fileExists(atPath: url.path) {
+            createSegment(seq: activeSeq)
+        }
+        do {
+            let handle = try FileHandle(forWritingTo: url)
+            defer { try? handle.close() }
+            try handle.seekToEnd()
+            try handle.write(contentsOf: data)
+            activeSize += UInt64(data.count)
+        } catch {
+            dropped &+= UInt64(data.reduce(0) { $1 == Self.newline ? $0 + 1 : $0 })
+            Self.log.error("Segment write failed: \(error.localizedDescription, privacy: .public)")
+        }
+    }
+
+    private func rotate() {
+        guard activeSize > 0 else { return }
+        activeSeq += 1
+        activeSize = 0
+        createSegment(seq: activeSeq)
+    }
+
+    private func createSegment(seq: UInt64) {
+        let url = segmentURL(seq)
+        if !fileManager.createFile(atPath: url.path, contents: nil, attributes: [.protectionKey: Self.protection]) {
+            Self.log.error("Could not create segment \(seq)")
+        }
+    }
+
+    // MARK: - Caps
+
+    private func enforceCaps() {
+        var changed = false
+        while true {
+            let segments = listSegments()
+            guard let oldest = segments.first else { break }
+            let total = segments.reduce(UInt64(0)) { $0 + fileSize($1.url) }
+            let modified = (try? fileManager.attributesOfItem(atPath: oldest.url.path)[.modificationDate]) as? Date
+            let tooBig = total > UInt64(maxTotalBytes)
+            let tooOld = modified.map { Date().timeIntervalSince($0) > maxAge } ?? false
+            guard tooBig || tooOld else { break }
+
+            if oldest.seq == activeSeq {
+                if segments.count > 1 { break }
+                if activeSize == 0 {
+                    activeSeq += 1
+                    createSegment(seq: activeSeq)
+                } else {
+                    rotate()
+                }
+            }
+
+            dropped &+= unreadLines(in: oldest)
+            removeFile(oldest.url)
+            if let next = listSegments().first, cursor.segment <= oldest.seq {
+                cursor = Cursor(segment: next.seq, offset: 0)
+            }
+            changed = true
+        }
+        if changed { saveState() }
+    }
+
+    private func unreadLines(in segment: Segment) -> UInt64 {
+        if segment.seq < cursor.segment { return 0 }
+        guard let data = try? Data(contentsOf: segment.url) else { return 0 }
+        let start = segment.seq == cursor.segment ? Int(min(cursor.offset, UInt64(data.count))) : 0
+        var count: UInt64 = 0
+        for byte in data[start...] where byte == Self.newline {
+            count += 1
+        }
+        return count
+    }
+
+    // MARK: - Reading
+
+    private func readBatch(maxBytes: Int, maxRecords: Int) -> Batch? {
+        let start = cursor
+        var pos = cursor
+        var items: [(record: LogRecord, end: Cursor)] = []
+        var itemSkips: [Int] = []
+        var pendingSkips = 0
+        var bytes = 0
+        var limitHit = false
+        var skippingOverlongLine = false
+
+        while !limitHit {
+            let segments = listSegments()
+            guard let segment = segments.first(where: { $0.seq == pos.segment }) else {
+                guard let next = segments.first(where: { $0.seq > pos.segment }) else { break }
+                pos = Cursor(segment: next.seq, offset: 0)
+                continue
+            }
+            let isActive = segment.seq == activeSeq
+
+            guard let data = readWindow(of: segment.url, offset: pos.offset, length: maxBytes), !data.isEmpty else {
+                if !isActive, let next = segments.first(where: { $0.seq > segment.seq }) {
+                    pos = Cursor(segment: next.seq, offset: 0)
+                    continue
+                }
+                break
+            }
+
+            var consumed = 0
+            let windowStart = pos.offset
+            while consumed < data.count {
+                let from = data.startIndex + consumed
+                guard let newlineIndex = data[from...].firstIndex(of: Self.newline) else { break }
+                let lineLength = newlineIndex - from + 1
+                if !items.isEmpty, bytes + lineLength > maxBytes {
+                    limitHit = true
+                    break
+                }
+                let lineEnd = Cursor(segment: segment.seq, offset: windowStart + UInt64(consumed + lineLength))
+                consumed += lineLength
+                if skippingOverlongLine {
+                    // Tail of an over-long row already counted as one skip
+                    skippingOverlongLine = false
+                } else if lineLength > 1 {
+                    let line = Data(data[from..<newlineIndex])
+                    if let record = try? decoder.decode(LogRecord.self, from: line) {
+                        items.append((record, lineEnd))
+                        itemSkips.append(pendingSkips)
+                        pendingSkips = 0
+                        bytes += lineLength
+                    } else {
+                        pendingSkips += 1
+                    }
+                }
+                pos = lineEnd
+                if items.count >= maxRecords || bytes >= maxBytes {
+                    limitHit = true
+                    break
+                }
+            }
+            if limitHit { break }
+
+            if consumed == 0 {
+                if data.count >= maxBytes {
+                    let skipEnd = Cursor(segment: segment.seq, offset: pos.offset + UInt64(data.count))
+                    if !skippingOverlongLine { pendingSkips += 1 }
+                    skippingOverlongLine = true
+                    pos = skipEnd
+                } else if !isActive, let next = segments.first(where: { $0.seq > segment.seq }) {
+                    pos = Cursor(segment: next.seq, offset: 0)
+                } else {
+                    break
+                }
+            }
+        }
+
+        // Skips after the last item are re-read (and counted) by the next batch, so only earlier ones count here.
+        let skipped = items.isEmpty ? pendingSkips : itemSkips.reduce(0, +)
+
+        if items.isEmpty, skipped == 0, Self.precedes(cursor, pos) {
+            cursor = pos
+            saveState()
+        } else if dropped != 0 {
+            saveState()
+        }
+
+        if items.isEmpty, dropped == 0, skipped == 0 { return nil }
+        return Batch(
+            start: start,
+            items: items,
+            itemSkips: itemSkips,
+            end: items.last?.end ?? pos,
+            persistedDropped: dropped,
+            skippedInBatch: UInt64(skipped)
+        )
+    }
+
+    private func readWindow(of url: URL, offset: UInt64, length: Int) -> Data? {
+        do {
+            let handle = try FileHandle(forReadingFrom: url)
+            defer { try? handle.close() }
+            try handle.seek(toOffset: offset)
+            return try handle.read(upToCount: length)
+        } catch {
+            Self.log.error("Segment read failed: \(error.localizedDescription, privacy: .public)")
+            return nil
+        }
+    }
+
+    // MARK: - Files
+
+    private var stateURL: URL {
+        directory.appendingPathComponent("state.json")
+    }
+
+    private func segmentURL(_ seq: UInt64) -> URL {
+        directory.appendingPathComponent("seg-" + String(format: "%020llu", seq) + ".jsonl")
+    }
+
+    private func listSegments() -> [Segment] {
+        let names = (try? fileManager.contentsOfDirectory(atPath: directory.path)) ?? []
+        return names.compactMap { name -> Segment? in
+            guard name.hasPrefix("seg-"), name.hasSuffix(".jsonl") else { return nil }
+            let digits = name.dropFirst(4).dropLast(6)
+            guard let seq = UInt64(digits) else { return nil }
+            return Segment(seq: seq, url: directory.appendingPathComponent(name))
+        }
+        .sorted { $0.seq < $1.seq }
+    }
+
+    private func fileSize(_ url: URL) -> UInt64 {
+        let size = (try? fileManager.attributesOfItem(atPath: url.path)[.size]) as? NSNumber
+        return size?.uint64Value ?? 0
+    }
+
+    private func lastByte(of url: URL, size: UInt64) -> UInt8? {
+        do {
+            let handle = try FileHandle(forReadingFrom: url)
+            defer { try? handle.close() }
+            try handle.seek(toOffset: size - 1)
+            return try handle.read(upToCount: 1)?.first
+        } catch {
+            Self.log.error("Segment tail read failed: \(error.localizedDescription, privacy: .public)")
+            return nil
+        }
+    }
+
+    private func removeFile(_ url: URL) {
+        do {
+            try fileManager.removeItem(at: url)
+        } catch {
+            Self.log.error("Segment delete failed: \(error.localizedDescription, privacy: .public)")
+        }
+    }
+
+    private func saveState() {
+        let state = State(segment: cursor.segment, offset: cursor.offset, dropped: dropped)
+        do {
+            let data = try JSONEncoder().encode(state)
+            try data.write(to: stateURL, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        } catch {
+            Self.log.error("State save failed: \(error.localizedDescription, privacy: .public)")
+        }
+    }
+
+    private static func precedes(_ lhs: Cursor, _ rhs: Cursor) -> Bool {
+        lhs.segment != rhs.segment ? lhs.segment < rhs.segment : lhs.offset < rhs.offset
+    }
+}
diff --git a/Trio/Sources/Logger/CloudLogging/CloudLogSink.swift b/Trio/Sources/Logger/CloudLogging/CloudLogSink.swift
new file mode 100644
index 000000000..0ec25d67c
--- /dev/null
+++ b/Trio/Sources/Logger/CloudLogging/CloudLogSink.swift
@@ -0,0 +1,149 @@
+import Foundation
+import os
+import UIKit
+
+// Feeds every log record (phone and watch) into the durable CloudLogQueue. accept() only touches an
+// in-memory buffer under a lock; the hand-off to disk happens on a private queue, coalesced.
+final class CloudLogSink: LogSink, @unchecked Sendable {
+    static let shared = CloudLogSink()
+
+    static let pendingLimit = 5000
+    static let batchSize = 200
+    static let flushDelay: TimeInterval = 1
+
+    private static let enabledKey = "cloudLogging.enabled"
+    private static let osLogger = os.Logger(
+        subsystem: Bundle.main.bundleIdentifier ?? "org.nightscout.Trio",
+        category: "CloudLogging"
+    )
+
+    private struct Pending: Sendable {
+        var records: [LogRecord] = []
+        var droppedCount: UInt64 = 0
+        var enabled: Bool
+        var flushScheduled = false
+        var batchFlushScheduled = false
+    }
+
+    private let cloudQueue: CloudLogQueue
+    private let defaults: UserDefaults
+    private let notificationCenter: Foundation.NotificationCenter
+    private let pending: OSAllocatedUnfairLock<Pending>
+    private let queue = DispatchQueue(label: "CloudLogSink.queue", qos: .utility)
+    private var observers: [NSObjectProtocol] = []
+
+    init(
+        queue cloudQueue: CloudLogQueue = .shared,
+        defaults: UserDefaults = .standard,
+        notificationCenter: Foundation.NotificationCenter = .default
+    ) {
+        self.cloudQueue = cloudQueue
+        self.defaults = defaults
+        self.notificationCenter = notificationCenter
+        pending = OSAllocatedUnfairLock(initialState: Pending(enabled: Self.readEnabled(defaults)))
+
+        observers = [
+            notificationCenter.addObserver(
+                forName: UserDefaults.didChangeNotification,
+                object: defaults,
+                queue: nil
+            ) { [weak self] _ in
+                guard let self else { return }
+                self.queue.async { self.refreshEnabled() }
+            },
+            notificationCenter.addObserver(
+                forName: UIApplication.didEnterBackgroundNotification,
+                object: nil,
+                queue: nil
+            ) { [weak self] _ in
+                guard let self else { return }
+                self.queue.async { self.drain(synchronously: false) }
+            },
+            notificationCenter.addObserver(
+                forName: UIApplication.willTerminateNotification,
+                object: nil,
+                queue: nil
+            ) { [weak self] _ in
+                guard let self else { return }
+                self.queue.sync { self.drain(synchronously: true) }
+            }
+        ]
+    }
+
+    deinit {
+        for observer in observers {
+            notificationCenter.removeObserver(observer)
+        }
+    }
+
+    func accept(_ record: LogRecord) {
+        let (scheduleDelayed, flushNow) = pending.withLock { state -> (Bool, Bool) in
+            guard state.enabled else { return (false, false) }
+            state.records.append(record)
+            if state.records.count > Self.pendingLimit {
+                // Drop a chunk so a full buffer doesn't shift on every record
+                let excess = state.records.count - Self.pendingLimit
+                let dropCount = max(excess, Self.pendingLimit / 10)
+                state.records.removeFirst(dropCount)
+                state.droppedCount += UInt64(dropCount)
+            }
+            let scheduleDelayed = !state.flushScheduled
+            state.flushScheduled = true
+            let flushNow = state.records.count >= Self.batchSize && !state.batchFlushScheduled
+            if flushNow { state.batchFlushScheduled = true }
+            return (scheduleDelayed, flushNow)
+        }
+        if flushNow {
+            queue.async { self.drain(synchronously: false) }
+        }
+        if scheduleDelayed {
+            queue.asyncAfter(deadline: .now() + Self.flushDelay) {
+                self.drain(synchronously: false)
+            }
+        }
+    }
+
+    func flush() async {
+        await withCheckedContinuation { continuation in
+            queue.async {
+                self.drain(synchronously: true)
+                continuation.resume()
+            }
+        }
+    }
+
+    func records(in _: DateInterval, minimumLevel _: LogLevel) async -> [LogRecord] {
+        []
+    }
+
+    private static func readEnabled(_ defaults: UserDefaults) -> Bool {
+        defaults.object(forKey: enabledKey) as? Bool != false
+    }
+
+    private func refreshEnabled() {
+        let enabled = Self.readEnabled(defaults)
+        pending.withLock { $0.enabled = enabled }
+    }
+
+    private func drain(synchronously: Bool) {
+        let (records, dropped) = pending.withLock { state -> ([LogRecord], UInt64) in
+            defer {
+                state.records = []
+                state.droppedCount = 0
+                state.flushScheduled = false
+                state.batchFlushScheduled = false
+            }
+            return (state.records, state.droppedCount)
+        }
+        if dropped > 0 {
+            cloudQueue.addDropped(dropped)
+            Self.osLogger.warning("Pending buffer overflowed; dropped \(dropped, privacy: .public) rows")
+        }
+        guard !records.isEmpty else { return }
+        if synchronously {
+            cloudQueue.appendSync(records)
+        } else {
+            cloudQueue.append(records)
+        }
+    }
+}
diff --git a/Trio/Sources/Logger/CloudLogging/CloudLogUploadService.swift b/Trio/Sources/Logger/CloudLogging/CloudLogUploadService.swift
new file mode 100644
index 000000000..e390882d4
--- /dev/null
+++ b/Trio/Sources/Logger/CloudLogging/CloudLogUploadService.swift
@@ -0,0 +1,273 @@
+import Foundation
+import os
+import UIKit
+
+/// App lifecycle + periodic trigger wrapper that drains `CloudLogQueue` to the cloud provider.
+///
+/// - Manual trigger: `uploadNow()`
+/// - Lifecycle triggers: foreground/background
+/// - Periodic trigger: every 30 seconds while app is running
+/// - Build change: one pass at start when `CFBundleVersion` differs from the last run
+final class CloudLogUploadService {
+    // Settings UI (first-choice config)
+    static let userDefaultsEnabledKey = "cloudLogging.enabled"
+    static let userDefaultsTokenKey = "cloudLogging.token"
+    static let userDefaultsIngestionURLKey = "cloudLogging.ingestionUrl"
+
+    // Legacy key (kept for backwards compatibility)
+    static let legacyUserDefaultsTokenKey = "cloudLogging.betterStackSourceToken"
+
+    private static let maxBatchesPerPass = 20
+    private static let maxRequestsPerPass = 100
+    private static let batchMaxBytes = 768_000
+    private static let batchMaxRecords = 1000
+    private static let maxRequestBytes = 1_000_000
+
+    // Cloud logging must not use TrioLogger, otherwise upload failures would feed rows back into the queue.
+    private static let osLog = os.Logger(
+        subsystem: Bundle.main.bundleIdentifier ?? "org.nightscout.Trio",
+        category: "CloudLogging"
+    )
+
+    private let provider: BetterStackLogtailProvider
+    private var timer: Timer?
+    private var observers: [NSObjectProtocol] = []
+    private let tokenProvider: () -> String?
+    private let ingestionURLProvider: () -> URL?
+    private let passInFlight = OSAllocatedUnfairLock<Bool>(initialState: false)
+
+    init() {
+        tokenProvider = {
+            let ud = UserDefaults.standard
+
+            // If the user explicitly disabled cloud logging, do not fall back to file/env.
+            if let enabled = ud.object(forKey: Self.userDefaultsEnabledKey) as? Bool, enabled == false {
+                return nil
+            }
+
+            // Priority: Settings UI (UserDefaults) → app group settings/BetterStack.json → Info.plist → env.
+            if let enabled = ud.object(forKey: Self.userDefaultsEnabledKey) as? Bool, enabled == true {
+                if let t = ud.string(forKey: Self.userDefaultsTokenKey), !t.isEmpty { return t }
+                if let t = ud.string(forKey: Self.legacyUserDefaultsTokenKey), !t.isEmpty { return t }
+                // If enabled but no token set in UI, allow file-based config.
+            } else {
+                // No explicit enable flag; still allow legacy token key.
+                if let t = ud.string(forKey: Self.legacyUserDefaultsTokenKey), !t.isEmpty { return t }
+            }
+
+            if let settings = BetterStackSettingsStore.load(),
+               let t = settings.BetterStackSourceToken,
+               !t.isEmpty
+            {
+                return t
+            }
+
+            if let t = Bundle.main.object(forInfoDictionaryKey: "BetterStackSourceToken") as? String, !t.isEmpty { return t }
+            return ProcessInfo.processInfo.environment["BETTERSTACK_SOURCE_TOKEN"]
+        }
+
+        ingestionURLProvider = {
+            let ud = UserDefaults.standard
+
+            if let enabled = ud.object(forKey: Self.userDefaultsEnabledKey) as? Bool, enabled == false {
+                return nil
+            }
+
+            if let enabled = ud.object(forKey: Self.userDefaultsEnabledKey) as? Bool, enabled == true {
+                if let raw = ud.string(forKey: Self.userDefaultsIngestionURLKey), !raw.isEmpty {
+                    return URL(string: raw)
+                }
+            }
+
+            if let settings = BetterStackSettingsStore.load(),
+               let raw = settings.BetterStackIngestionUrl,
+               let url = URL(string: raw)
+            {
+                return url
+            }
+            return URL(string: "https://in.logs.betterstack.com/")
+        }
+
+        provider = BetterStackLogtailProvider(
+            tokenProvider: tokenProvider,
+            ingestionURLProvider: ingestionURLProvider
+        )
+
+        start()
+    }
+
+    deinit {
+        stop()
+    }
+
+    func uploadNow() {
+        guard isConfigured else { return }
+
+        Task { [weak self] in
+            await self?.runPass()
+        }
+    }
+
+    private var isConfigured: Bool {
+        guard let token = tokenProvider(), !token.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            return false
+        }
+        return ingestionURLProvider() != nil
+    }
+
+    // MARK: - Upload pass
+
+    private func runPass() async {
+        guard isConfigured else { return }
+
+        let acquired = passInFlight.withLock { running -> Bool in
+            if running { return false }
+            running = true
+            return true
+        }
+        guard acquired else { return }
+        defer { passInFlight.withLock { $0 = false } }
+
+        // Persist pending in-memory rows first so this pass (notably the background one) sees them.
+        await CloudLogSink.shared.flush()
+
+        let common = CloudLogCommonAttributes.current
+        let queue = CloudLogQueue.shared
+        var requests = 0
+
+        for _ in 0 ..< Self.maxBatchesPerPass {
+            guard let batch = await queue.nextBatch(
+                maxBytes: Self.batchMaxBytes,
+                maxRecords: Self.batchMaxRecords
+            ) else { return }
+
+            // Only dropped-row reporting to send (skipped rows or counter): no items to bisect.
+            if batch.items.isEmpty {
+                guard requests < Self.maxRequestsPerPass else { return }
+                requests += 1
+                let event = CloudLogEvent.dropped(count: batch.droppedToReport, common: common)
+                guard case .success = await provider.upload(events: [event]) else { return }
+                await queue.commit(through: batch.end, droppedReported: batch.persistedDropped)
+                continue
+            }
+
+            let itemEvents = batch.items.map { CloudLogEvent.make(from: $0.record, common: common) }
+            let itemEnds = batch.items.map(\.end)
+            let handlers = CloudLogBatchUploadDrain.Handlers(
+                encodedSize: { [provider] events in provider.encodedSize(of: events) },
+                upload: { [provider] events in await provider.upload(events: events) },
+                commit: { cursor, droppedReported in
+                    await queue.commit(through: cursor, droppedReported: droppedReported)
+                },
+                addDropped: { count in queue.addDropped(count) },
+                logRejectedRow: { status in
+                    Self.osLog.error("Cloud logging: dropping rejected row (status=\(status, privacy: .public))")
+                },
+                uploadDropVisibility: { [provider] event in
+                    _ = await provider.upload(events: [event])
+                }
+            )
+            let context = CloudLogBatchUploadDrain.Context(
+                itemEvents: itemEvents,
+                itemEnds: itemEnds,
+                itemSkips: batch.itemSkips,
+                persistedDropped: batch.persistedDropped,
+                rangeStart: batch.start,
+                common: common,
+                maxRequestBytes: Self.maxRequestBytes,
+                maxRequestsPerPass: Self.maxRequestsPerPass
+            )
+            switch await CloudLogBatchUploadDrain.drain(handlers: handlers, context: context, requests: &requests) {
+            case .batchComplete:
+                continue
+            case .stopPass:
+                return
+            }
+        }
+    }
+
+    // MARK: - Scheduling
+
+    private func start() {
+        // Determination rows ride the same cloud pipeline; start their observer with the uploader.
+        CloudDeterminationLogger.shared.start()
+        let center = Foundation.NotificationCenter.default
+
+        observers.append(
+            center.addObserver(
+                forName: UIApplication.willEnterForegroundNotification,
+                object: nil,
+                queue: .main
+            ) { [weak self] _ in
+                self?.uploadNow()
+            }
+        )
+
+        observers.append(
+            center.addObserver(
+                forName: UIApplication.didEnterBackgroundNotification,
+                object: nil,
+                queue: .main
+            ) { [weak self] _ in
+                self?.uploadInBackgroundTask()
+            }
+        )
+
+        startTimer()
+
+        // Detect build change and flush immediately so backlogged lines carry the old build
+        let lastKnownBuildKey = "cloudLogUploadService.lastKnownBuild"
+        let currentBuild = Bundle.main.infoDictionary?["CFBundleVersion"] as? String ?? "unknown"
+        let lastKnownBuild = UserDefaults.standard.string(forKey: lastKnownBuildKey)
+        if lastKnownBuild != currentBuild {
+            uploadNow()
+            UserDefaults.standard.set(currentBuild, forKey: lastKnownBuildKey)
+        }
+    }
+
+    private func uploadInBackgroundTask() {
+        guard isConfigured else { return }
+
+        let taskID = OSAllocatedUnfairLock<UIBackgroundTaskIdentifier>(initialState: .invalid)
+        let endTask: @Sendable () -> Void = {
+            let id = taskID.withLock { current -> UIBackgroundTaskIdentifier in
+                defer { current = .invalid }
+                return current
+            }
+            guard id != .invalid else { return }
+            DispatchQueue.main.async {
+                UIApplication.shared.endBackgroundTask(id)
+            }
+        }
+
+        let id = UIApplication.shared.beginBackgroundTask(withName: "CloudLogUpload") {
+            endTask()
+        }
+        taskID.withLock { $0 = id }
+
+        Task { [weak self] in
+            await self?.runPass()
+            endTask()
+        }
+    }
+
+    private func startTimer() {
+        timer?.invalidate()
+        let newTimer = Timer(timeInterval: 30, repeats: true) { [weak self] _ in
+            self?.uploadNow()
+        }
+        RunLoop.main.add(newTimer, forMode: .common)
+        timer = newTimer
+    }
+
+    private func stop() {
+        timer?.invalidate()
+        timer = nil
+
+        let center = Foundation.NotificationCenter.default
+        for o in observers {
+            center.removeObserver(o)
+        }
+        observers.removeAll()
+    }
+}
