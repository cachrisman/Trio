+                errorHandler: { _ in
+                    Task {
+                        await WatchLogger.shared.storePendingPayload(
+                            payloadId: payloadId,
+                            type: "watchLogs",
+                            filePath: filePath
+                        )
+                    }
+                }
+            )
+        } else {
+            _ = session.transferUserInfo(envelope)
+            await storePendingPayload(
+                payloadId: payloadId,
+                type: "watchLogs",
