+    private func saveComplicationSnapshot(from message: [String: Any]) {
+        var snapshot: [String: Any] = [:]
+
+        let timestamp = message[WatchMessageKeys.date] as? TimeInterval ?? Date().timeIntervalSince1970
+        snapshot["timestamp"] = timestamp
+
+        let glucoseValue = message[WatchMessageKeys.currentGlucose] as? String ?? currentGlucose
+        snapshot["glucose"] = glucoseValue
+
+        let trendValue = message[WatchMessageKeys.trend] as? String ?? trend ?? ""
+        snapshot["trend"] = trendValue
+
+        let deltaValue = message[WatchMessageKeys.delta] as? String ?? delta ?? ""
+        snapshot["delta"] = deltaValue
+
+        let defaults = complicationDefaults()
+        defaults.set(snapshot, forKey: complicationDefaultsKey)
+
+        // Force synchronization to ensure data is written immediately
+        defaults.synchronize()
+
+        Task {
+            await WatchLogger.shared.log("⌚️ Saved complication snapshot - glucose: \(glucoseValue), trend: \(trendValue), delta: \(deltaValue)")
+        }
+
+        // Force immediate timeline reload
+        if #available(watchOS 10.0, *) {
+            WidgetCenter.shared.reloadTimelines(ofKind: complicationKind)
+        } else {
+            WidgetCenter.shared.reloadAllTimelines()
+        }
+
+        // Also schedule a delayed reload to ensure the complication updates
+        DispatchQueue.main.asyncAfter(deadline: .now() + 2.0) {
+            if #available(watchOS 10.0, *) {
+                WidgetCenter.shared.reloadTimelines(ofKind: self.complicationKind)
+            } else {
+                WidgetCenter.shared.reloadAllTimelines()
+            }
+        }
+    }
+
+    private func complicationDefaults() -> UserDefaults {
+        if let suiteName = Bundle.main.object(forInfoDictionaryKey: "AppGroupID") as? String,
+           let defaults = UserDefaults(suiteName: suiteName)
+        {
+            return defaults
+        }
+
+        Task {
+            await WatchLogger.shared.log("⚠️ WatchState: AppGroupID not found, using standard UserDefaults for complication data")
+        }
+        return .standard
+    }
+    
+    /// Manually trigger a complication update with current state
+    func forceComplicationUpdate() {
+        Task {
+            await WatchLogger.shared.log("⌚️ Forcing complication update with current state")
+        }
+        
+        var snapshot: [String: Any] = [:]
+        snapshot["timestamp"] = Date().timeIntervalSince1970
+        snapshot["glucose"] = currentGlucose
+        snapshot["trend"] = trend ?? ""
+        snapshot["delta"] = delta ?? ""
+        
+        let defaults = complicationDefaults()
+        defaults.set(snapshot, forKey: complicationDefaultsKey)
+        defaults.synchronize()
+        
+        if #available(watchOS 10.0, *) {
+            WidgetCenter.shared.reloadTimelines(ofKind: complicationKind)
+        } else {
+            WidgetCenter.shared.reloadAllTimelines()
+        }
     }
 }
