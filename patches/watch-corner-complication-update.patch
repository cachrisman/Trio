diff --git a/Trio Watch Complication/TrioWatchComplication.swift b/Trio Watch Complication/TrioWatchComplication.swift
index 411968936..f79682b1a 100644
--- a/Trio Watch Complication/TrioWatchComplication.swift	
+++ b/Trio Watch Complication/TrioWatchComplication.swift	
@@ -1,28 +1,214 @@
 import SwiftUI
 import WidgetKit
 
+private enum ComplicationDefaults {
+    static let latestStateKey = "TrioWatchComplication.latestState"
+    static let widgetKind = "TrioWatchComplication"
+    static let fallbackGlucose = "--"
+    static let fallbackDelta = "--"
+}
+
+private func complicationSharedDefaults() -> UserDefaults {
+    if let suiteName = Bundle.main.object(forInfoDictionaryKey: "AppGroupID") as? String,
+       let defaults = UserDefaults(suiteName: suiteName)
+    {
+        return defaults
+    }
+    
+    // Fallback to standard UserDefaults if AppGroupID is not available
+    print("⚠️ Complication: AppGroupID not found, using standard UserDefaults")
+    return .standard
+}
+
 // MARK: - Timeline Entry
 
 struct TrioWatchComplicationEntry: TimelineEntry {
     let date: Date
+    let glucose: String
+    let trend: String
+    let delta: String
+
+    var trendSymbol: String {
+        TrendSymbolMapper.symbol(from: trend)
+    }
+
+    var formattedGlucoseLine: String {
+        let trimmedGlucose = glucose.trimmingCharacters(in: .whitespacesAndNewlines)
+        let glucoseText = trimmedGlucose.isEmpty ? ComplicationDefaults.fallbackGlucose : trimmedGlucose
+        let trendText = trendSymbol
+        if trendText.isEmpty {
+            return glucoseText
+        }
+        return "\(glucoseText) \(trendText)"
+    }
+
+    var formattedDeltaLine: String {
+        let deltaText = sanitizedDelta
+        let ageText = recencyDescription
+        if deltaText.isEmpty {
+            return ageText
+        }
+        return "\(deltaText) • \(ageText)"
+    }
+
+    private var sanitizedDelta: String {
+        let trimmedDelta = delta.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmedDelta.isEmpty else { return ComplicationDefaults.fallbackDelta }
+        return trimmedDelta
+    }
+
+    private var recencyDescription: String {
+        let now = Date()
+        let interval = max(0, now.timeIntervalSince(date))
+        if interval < 60 {
+            return "now"
+        }
+
+        let minutes = Int(interval / 60)
+        return "\(minutes)m ago"
+    }
+}
+
+// MARK: - Snapshot Loading
+
+private struct ComplicationSnapshot {
+    let glucose: String
+    let trend: String
+    let delta: String
+    let date: Date
+
+    init?(dictionary: [String: Any]) {
+        guard let timestamp = dictionary["timestamp"] as? TimeInterval else { 
+            print("⚠️ ComplicationSnapshot: Missing timestamp in dictionary: \(dictionary)")
+            return nil 
+        }
+        let glucose = dictionary["glucose"] as? String ?? ComplicationDefaults.fallbackGlucose
+        let trend = dictionary["trend"] as? String ?? ""
+        let delta = dictionary["delta"] as? String ?? ComplicationDefaults.fallbackDelta
+
+        self.glucose = glucose
+        self.trend = trend
+        self.delta = delta
+        date = Date(timeIntervalSince1970: timestamp)
+        
+        print("📊 ComplicationSnapshot: Created with glucose=\(glucose), trend=\(trend), delta=\(delta), date=\(date)")
+    }
+
+    static func loadLatest() -> ComplicationSnapshot? {
+        let defaults = complicationSharedDefaults()
+        guard let dictionary = defaults.dictionary(forKey: ComplicationDefaults.latestStateKey) else {
+            print("⚠️ Complication: No saved data found for key: \(ComplicationDefaults.latestStateKey)")
+            return nil
+        }
+        
+        guard let snapshot = ComplicationSnapshot(dictionary: dictionary) else {
+            print("⚠️ Complication: Failed to create snapshot from dictionary: \(dictionary)")
+            return nil
+        }
+        
+        print("✅ Complication: Loaded snapshot - glucose: \(snapshot.glucose), trend: \(snapshot.trend), delta: \(snapshot.delta)")
+        return snapshot
+    }
+}
+
+private enum TrendSymbolMapper {
+    static func symbol(from rawValue: String) -> String {
+        switch rawValue {
+        case "TripleUp":
+            return "↑↑↑"
+        case "DoubleUp":
+            return "↑↑"
+        case "SingleUp":
+            return "↑"
+        case "FortyFiveUp":
+            return "↗︎"
+        case "Flat":
+            return "→"
+        case "FortyFiveDown":
+            return "↘︎"
+        case "SingleDown":
+            return "↓"
+        case "DoubleDown":
+            return "↓↓"
+        case "TripleDown":
+            return "↓↓↓"
+        case "NONE",
+             "NOT COMPUTABLE",
+             "NotComputable",
+             "RATE OUT OF RANGE":
+            return "↔︎"
+        default:
+            if rawValue.contains("↑") || rawValue.contains("↓") || rawValue.contains("→") || rawValue.contains("↗") || rawValue
+                .contains("↘︎")
+            {
+                return rawValue
+            }
+            return ""
+        }
+    }
 }
 
 // MARK: - Provider
 
 struct TrioWatchComplicationProvider: TimelineProvider {
+    private let refreshInterval: TimeInterval = 30 // More frequent updates
+
     func placeholder(in _: Context) -> TrioWatchComplicationEntry {
-        TrioWatchComplicationEntry(date: Date())
+        TrioWatchComplicationEntry(
+            date: Date(),
+            glucose: "110",
+            trend: "Flat",
+            delta: "+1"
+        )
     }
 
-    func getSnapshot(in _: Context, completion: @escaping (TrioWatchComplicationEntry) -> Void) {
-        let entry = TrioWatchComplicationEntry(date: Date())
-        completion(entry)
+    func getSnapshot(in context: Context, completion: @escaping (TrioWatchComplicationEntry) -> Void) {
+        if context.isPreview {
+            completion(placeholder(in: context))
+            return
+        }
+
+        completion(loadLatestEntry())
     }
 
     func getTimeline(in _: Context, completion: @escaping (Timeline<TrioWatchComplicationEntry>) -> Void) {
-        let entry = TrioWatchComplicationEntry(date: Date())
-        let timeline = Timeline(entries: [entry], policy: .never)
-        completion(timeline)
+        let entry = loadLatestEntry()
+        let nextRefresh = Date().addingTimeInterval(refreshInterval)
+        
+        // Create multiple entries for more frequent updates
+        let entries = [
+            entry,
+            TrioWatchComplicationEntry(
+                date: Date().addingTimeInterval(15),
+                glucose: entry.glucose,
+                trend: entry.trend,
+                delta: entry.delta
+            )
+        ]
+        
+        completion(Timeline(entries: entries, policy: .after(nextRefresh)))
+    }
+
+    private func loadLatestEntry() -> TrioWatchComplicationEntry {
+        print("🔍 Complication: Loading latest entry...")
+        
+        if let snapshot = ComplicationSnapshot.loadLatest() {
+            print("✅ Complication: Using saved snapshot data")
+            return TrioWatchComplicationEntry(
+                date: snapshot.date,
+                glucose: snapshot.glucose,
+                trend: snapshot.trend,
+                delta: snapshot.delta
+            )
+        }
+
+        print("⚠️ Complication: No saved data found, using fallback values")
+        return TrioWatchComplicationEntry(
+            date: Date(),
+            glucose: ComplicationDefaults.fallbackGlucose,
+            trend: "",
+            delta: ComplicationDefaults.fallbackDelta
+        )
     }
 }
 
