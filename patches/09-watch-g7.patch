+    private func formatDataAge(_ date: Date?, relativeTo now: Date) -> String {
+        guard let date else { return "—" }
+        let age = max(0, Int(now.timeIntervalSince(date)))
+        if age < 60 { return "\(age)s ago" }
+        if age < 3600 {
+            let m = age / 60
+            let s = age % 60
+            return "\(m)m \(s)s ago"
+        }
+        let h = age / 3600
+        let m = (age % 3600) / 60
+        return "\(h)h \(m)m ago"
+    }
