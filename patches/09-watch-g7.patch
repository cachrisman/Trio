+                        .log("✅ hk_background_delivery_registered success=true low_power_mode=\(ProcessInfo.processInfo.isLowPowerModeEnabled)")
+                } else {
+                    WatchLogger.shared
+                        .log("⚠️ hk_background_delivery_registered success=false low_power_mode=\(ProcessInfo.processInfo.isLowPowerModeEnabled)")
+                }
+            }
+
+            self.setupGlucoseObserverQuery(store: store, sampleType: bgType)
+        }
+    }
