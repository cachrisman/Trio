+                    state,
+                    sourcesSnapshot: sourcesSnapshot,
+                    lastEligibleSourceAt: lastEligibleSnapshot,
+                    windowStartEpoch: windowStartEpoch
+                )
+            }
+        }
+        pendingSendWorkItem = workItem
+        DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: workItem)
+    }
