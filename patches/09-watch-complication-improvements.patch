+                HStack {
+                    Text("Delta:")
+                    Spacer()
+                    Text(s.delta)
+                }
+
+                HStack {
+                    Text("Reading:")
+                    Spacer()
+                    VStack(alignment: .trailing, spacing: 2) {
+                        Text(formatTime(s.readingDate))
+                        Text("(\(formatAge(s.readingDate)))")
+                            .font(.caption2)
+                            .foregroundColor(ageColor(s.readingDate))
