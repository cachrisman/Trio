+        case .off:          return "off"
+        case .retrieving:   return "retr"
+        case .scanning:     return "scan"
+        case .connecting:   return "conn"
+        case .active:       return "ok"
+        case .fastRetry:    return "retry"
+        case .moderateWait: return "wait"
+        case .unavailable:  return "n/a"
+        }
+    }
+
