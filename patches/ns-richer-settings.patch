+import Foundation
+
+/// Trio‑specific algorithm configuration that Nightscout doesn’t receive today.
+/// All properties are optional to keep the JSON backward‑compatible.
+struct NightscoutAlgorithmSettings: Codable {
+    /// Dynamic‑ISF / Autosens enabled?
+    let dynamicISFEnabled: Bool?
+    /// Autosens upper limit (e.g. 1.20).
+    let autosensMax: Decimal?
+    /// Autosens lower limit (e.g. 0.70).
+    let autosensMin: Decimal?
+    /// Is SMB / automatic bolus allowed?
+    let smbAllowed: Bool?
+    /// App / algorithm build string or git hash.
+    let algorithmVersion: String?
+}

