+    private var previewReadingColor: Color {
+        guard state.bigGlucoseColorByRange else { return .primary }
+
+        let isMgdL = state.units == .mgdL
+
+        let hardCodedLow = isMgdL ? Decimal(55) : 55.asMmolL
