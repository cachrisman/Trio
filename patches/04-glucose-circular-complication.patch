+        date: now,
+        snapshot: GlucoseComplicationSnapshot(
+            glucose: "12.8",
+            trend: "FortyFiveDown",
+            delta: "-0.6",
+            glucoseColorHex: "#5BE5C0",
+            readingDate: now.addingTimeInterval(-59 * 60)
+        ),
+        settings: GlucoseBobbleComplicationSettings()
+    )
+}
+
+#Preview("DoubleUp", as: .accessoryCircular) {
+    TrioGlucoseBobbleComplication()
+} timeline: {
+    let now = Date()
+    GlucoseBobbleComplicationEntry(
+        date: now,
+        snapshot: GlucoseComplicationSnapshot(
+            glucose: "199",
+            trend: "DoubleUp",
+            delta: "+7",
+            glucoseColorHex: "#665BDD",
+            readingDate: now.addingTimeInterval(-9 * 60)
+        ),
+        settings: GlucoseBobbleComplicationSettings()
+    )
+}
+
+#Preview("Loop status, white", as: .accessoryCircular) {
+    TrioGlucoseBobbleComplication()
+} timeline: {
